-- Функции кастомизации интерфейса (Темы и Прозрачность)
cycleTheme = function()
	local themeKeys = {"dark", "cyber", "minimal", "amethyst"}
	local currentIndex = 1
	for i, k in ipairs(themeKeys) do
		if k == RUNTIME.THEME then
			currentIndex = i
			break
		end
	end
	local nextIndex = (currentIndex % #themeKeys) + 1
	RUNTIME.THEME = themeKeys[nextIndex]
	CURRENT_THEME = THEMES[RUNTIME.THEME]
	
	if gui then
		gui:Destroy()
	end
	buildGui()
	refreshButtons()
end

cycleTransparency = function()
	local transLevels = {0.04, 0.25, 0.50, 0.80}
	local currentIndex = 1
	for i, t in ipairs(transLevels) do
		if math.abs(t - RUNTIME.TRANSPARENCY) < 0.05 then
			currentIndex = i
			break
		end
	end
	local nextIndex = (currentIndex % #transLevels) + 1
	RUNTIME.TRANSPARENCY = transLevels[nextIndex]
	if panel then
		panel.BackgroundTransparency = RUNTIME.TRANSPARENCY
	end
end

refreshButtons = function()
	if not btns.auto then
		return
	end
	setBtn(btns.auto, RUNTIME.AUTO, RUNTIME.AUTO and "AUTOPLAY   ON" or "AUTOPLAY   OFF")
	setBtn(btns.legit, RUNTIME.STYLE == "legit", "STYLE  LEGIT", CURRENT_THEME.on)
	setBtn(btns.raj, RUNTIME.STYLE == "raj", "STYLE  RAJ", CURRENT_THEME.raj)
	setBtn(btns.best, RUNTIME.MODE == "best", "PLAY  BEST")
	setBtn(btns.elo, RUNTIME.MODE == "elo", "PLAY  ELO " .. RUNTIME.ELO)
	setBtn(btns.engineLocal, RUNTIME.SOURCE == "local", "ENGINE  LOCAL")
	setBtn(btns.engineVortex, RUNTIME.SOURCE == "vortex", "ENGINE  VORTEX")
	if btns.theme then
		btns.theme.Text = "THEME: " .. string.upper(RUNTIME.THEME)
	end
end

local function layoutPanel()
	if dragged or not panel or not panel.Parent then
		return
	end
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	if vp.X >= 800 then
		panel.Position = UDim2.fromOffset(vp.X - CFG.W - CFG.MARGIN, CFG.TOP)
	end
end

